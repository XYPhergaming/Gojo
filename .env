# Firebase Web Config (backend uses FIREBASE_API_KEY for identitytoolkit REST)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK credentials (REQUIRED)
# Paste the full JSON string of the service account on a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative: individual fields
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Third-party secrets
IMGBB_KEY=
GEMINI_KEY=

# Public API endpoints
ANILIST_GRAPHQL=https://graphql.anilist.co
MANGADEX_API=https://api.mangadex.org
MANGADEX_COVERS=https://uploads.mangadex.org
TRACEMOE_API=https://api.trace.moe
KITSU_API=https://kitsu.io/api/edge
RADIO_BROWSER_API=https://de1.api.radio-browser.info
NEKOS_BEST_API=https://nekos.best/api/v2
ANIME_NEWS_RSS=https://www.animenewsnetwork.com/all/rss.xml
ALLORIGINS_PROXY=https://api.allorigins.win/raw?url=
CODETABS_PROXY=https://api.codetabs.com/v1/proxy?quest=
CORSPROXY=https://corsproxy.io/?url=

# Comma-separated list of allowed frontend origins. Use * for wildcard.
CORS_ORIGINS=*