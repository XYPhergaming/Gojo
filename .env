# Firebase Admin (download JSON from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# JWT secret (generate with: openssl rand -hex 64)
JWT_SECRET=replace-with-a-64-char-hex-string

# Third-party API keys
IMGBB_KEY=your-imgbb-key
GEMINI_KEY=your-gemini-key

# CORS
ALLOWED_ORIGIN=*

# Public APIs (do not change unless upstream URL changes)
ANILIST_GRAPHQL=https://graphql.anilist.co
MANGADEX_API=https://api.mangadex.org
MANGADEX_COVERS=https://uploads.mangadex.org
TRACEMOE_API=https://api.trace.moe
KITSU_API=https://kitsu.io/api/edge
RADIO_BROWSER_API=https://de1.api.radio-browser.info
NEKOS_BEST_API=https://nekos.best/api/v2
ANIME_NEWS_RSS=https://www.animenewsnetwork.com/all/rss.xml
ALLORIGINS_PROXY=https://api.allorigins.win/raw?url=
CODETABS_PROXY=https://api.codetabs.com/v1/proxy?quest=
CORSPROXY=https://corsproxy.io/?url=