const axios = require('axios');
const config = require('./api');

async function uploadImage(base64, name) {
  if (!config.imgbb.key) throw new Error('IMGBB_KEY is not configured');
  if (!base64 || typeof base64 !== 'string') throw new Error('No image data');
  const body = new URLSearchParams();
  body.append('image', base64);
  if (name) body.append('name', name);
  const res = await axios.post(
    `${config.imgbb.endpoint}?key=${config.imgbb.key}`,
    body.toString(),
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, timeout: 30000 }
  );
  if (!res.data || !res.data.success) throw new Error('ImgBB upload failed');
  return res.data.data.url;
}

module.exports = { uploadImage };