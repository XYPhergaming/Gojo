const axios = require('axios');
const config = require('./api');

async function uploadImage(base64Image) {
  if (!base64Image || typeof base64Image !== 'string') {
    throw new Error('Invalid image');
  }
  const clean = base64Image.replace(/^data:image\/\w+;base64,/, '');
  const body = new URLSearchParams();
  body.append('image', clean);
  const res = await axios.post(
    `https://api.imgbb.com/1/upload?key=${config.imgbb}`,
    body.toString(),
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, timeout: 20000 }
  );
  if (!res.data || !res.data.success) throw new Error('Upload failed');
  return res.data.data.url;
}

module.exports = { uploadImage };